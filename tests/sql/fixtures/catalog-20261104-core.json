  "views": [
    {
      "name": "events_main",
      "ddl": "CREATE OR REPLACE VIEW public.events_main WITH (security_invoker=true) AS\n SELECT id,\n    anonymous_id,\n    session_id,\n    name,\n    url,\n    path,\n    hostname,\n    title,\n    referrer,\n    referrer_hostname,\n    utm_source,\n    utm_medium,\n    utm_campaign,\n    utm_term,\n    utm_content,\n    user_agent,\n    device_type,\n    os,\n    browser,\n    viewport_width,\n    viewport_height,\n    props,\n    occurred_at,\n    received_at\n   FROM events e\n  WHERE cooked_is_main_site(hostname, props);"
    },
    {
      "name": "events_no_bots",
      "ddl": "CREATE OR REPLACE VIEW public.events_no_bots WITH (security_invoker=true) AS\n SELECT id,\n    anonymous_id,\n    session_id,\n    name,\n    url,\n    path,\n    hostname,\n    title,\n    referrer,\n    referrer_hostname,\n    utm_source,\n    utm_medium,\n    utm_campaign,\n    utm_term,\n    utm_content,\n    user_agent,\n    device_type,\n    os,\n    browser,\n    viewport_width,\n    viewport_height,\n    props,\n    occurred_at,\n    received_at\n   FROM events_main e\n  WHERE NOT (EXISTS ( SELECT 1\n           FROM bot_fingerprints b\n          WHERE b.anonymous_id = e.anonymous_id));"
    },
    {
      "name": "events_human",
      "ddl": "CREATE OR REPLACE VIEW public.events_human WITH (security_invoker=true) AS\n SELECT id,\n    anonymous_id,\n    session_id,\n    name,\n    url,\n    path,\n    hostname,\n    title,\n    referrer,\n    referrer_hostname,\n    utm_source,\n    utm_medium,\n    utm_campaign,\n    utm_term,\n    utm_content,\n    user_agent,\n    device_type,\n    os,\n    browser,\n    viewport_width,\n    viewport_height,\n    props,\n    occurred_at,\n    received_at\n   FROM events_no_bots e\n  WHERE NOT (EXISTS ( SELECT 1\n           FROM noise_sessions n\n          WHERE n.session_id = e.session_id)) AND NOT (name = 'cta_anchor_click'::text AND cooked_is_chrome_anchor(props)) AND NOT ((name = ANY (ARRAY['cta_phone_click'::text, 'cta_booking_click'::text, 'cta_anchor_click'::text, 'click_internal'::text, 'click_outbound'::text])) AND (EXISTS ( SELECT 1\n           FROM events_main d\n          WHERE (d.name = ANY (ARRAY['cta_phone_click'::text, 'cta_booking_click'::text, 'cta_anchor_click'::text, 'click_internal'::text, 'click_outbound'::text])) AND d.session_id = e.session_id AND d.name = e.name AND NOT d.path IS DISTINCT FROM e.path AND date_trunc('second'::text, (d.occurred_at AT TIME ZONE 'UTC'::text)) = date_trunc('second'::text, (e.occurred_at AT TIME ZONE 'UTC'::text)) AND NOT (d.props ->> 'anchor'::text) IS DISTINCT FROM (e.props ->> 'anchor'::text) AND d.id < e.id)));"
    }
  ],
