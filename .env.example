# Cooked — variables d'environnement (modèle, SANS secrets)
# Copier vers .env à la racine pour scripts locaux, ou vers dashboard/.env.local
# pour la sous-app Next.js (voir dashboard/.env.local.example).

# ── Supabase (projet mxycmjkeotrycyneacje) ─────────────────────────────────
SUPABASE_URL=https://mxycmjkeotrycyneacje.supabase.co
# Clé service sb_secret_* — scripts Python, Edge Functions, dashboard serveur
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optionnel : régénérer supabase/rpcs.sql (scripts/generate_rpcs_sql.py)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Edge Function track (secrets Supabase Dashboard → Edge Functions) ─────
ANON_SALT=xxx
ALLOWED_ORIGIN=https://www.jplouton-avocat.fr

# ── Edge Function form-webhook ────────────────────────────────────────────
FORM_WEBHOOK_SECRET=xxx

# ── Ingestion GSC (scripts/gsc_ingest.py, GitHub Actions) ─────────────────
# Fichier JSON service account — JAMAIS dans le repo (défaut : ~/.claude/gsc-credentials.json)
GSC_CREDENTIALS_PATH=/path/to/gsc-credentials.json
GSC_SITE_URL=https://www.jplouton-avocat.fr/
# GSC_END_DATE=2026-07-09

# ── Ingestion GBP / Google Business Profile (scripts/gbp_ingest.py) ───────
# OAuth one-shot : python3 scripts/gbp_oauth_setup.py --client-secrets …
# Token local (hors repo) : ~/.claude/gbp-token.json — ou les 3 vars ci-dessous.
# GBP_TOKEN_PATH=/path/to/gbp-token.json
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REFRESH_TOKEN=
# GBP_LOCATION_ID=   # optionnel — sinon auto-découverte des fiches du compte
# GBP_END_DATE=2026-07-22

# ── DataForSEO (scripts/dfs_sync.py, GitHub Actions — optionnel en local) ─
DFS_USERNAME=
DFS_PASSWORD=

# ── Déploiement Edge (CLI : npx supabase functions deploy — voir OPERATIONS.md) ─

# ── Dashboard Next.js (dashboard/ — détail dans dashboard/.env.local.example)
NEXT_PUBLIC_SUPABASE_URL=https://mxycmjkeotrycyneacje.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
DASHBOARD_ALLOWED_EMAILS=you@example.com
