# Cooked — modèles uniquement. Exporter les variables utiles dans le shell
# ou les configurer dans GitHub Actions / Supabase selon le flux.
# Les scripts Python ne chargent pas automatiquement un fichier .env.

# Imports Python (GSC, inventaire Wix, rapprochement Forms)
SUPABASE_URL=https://mxycmjkeotrycyneacje.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# GSC : fichier service account hors dépôt
GSC_CREDENTIALS_PATH=/path/to/gsc-credentials.json
GSC_SITE_URL=https://www.jplouton-avocat.fr/
# GSC_END_DATE=YYYY-MM-DD

# Rapprochement Forms seulement ; l’inventaire lit les données publiques Wix
WIX_API_KEY=xxx
# WIX_SITE_ID=0870235c-b92d-4a69-a2f4-25a976ae5f0c

# Edge track : secrets Supabase ; COOKED_INGEST_KEY est aussi dans Wix Secrets
COOKED_INGEST_KEY=xxx
ANON_SALT=xxx
ALLOWED_ORIGIN=https://www.jplouton-avocat.fr

# Edge form-webhook : secret partagé avec l’automatisation Wix
FORM_WEBHOOK_SECRET=xxx

# Contrôles de production : connexion du rôle de lecture seule configuré
# DATABASE_URL_RO=postgresql://user:password@host:5432/postgres
# Régénération SQL / contrôle des migrations : DATABASE_URL ou SUPABASE_DB_URL
# selon l’aide du script, avec le rôle approprié.

# Dashboard : modèle distinct dans dashboard/.env.local.example
