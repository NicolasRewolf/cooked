supabase/.temp/

.claude/settings.local.json
.env
.env.local
.env.*.local
!.env.example
!**/.env*.example
scripts/.env.dfs
node_modules/
*.log
__pycache__/
*.pyc
.deploy-*.json
.full-deploy.json
