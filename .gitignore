# Environnement et secrets : seuls les modèles sont versionnés
.env
.env.*
!.env.example
!**/.env*.example
*credentials*.json
service-account*.json
*.pem
*.key

# Dépendances, caches et sorties de compilation
node_modules/
*.log
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.venv/
*.egg-info/

# Artefact régénéré depuis wix/tracker.html avant chaque livraison
wix/tracker.min.html
