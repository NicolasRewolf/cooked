# Build artifact — tracker.min.html is regenerated from tracker.html
# at each Wix deploy. Source of truth = tracker.html.
wix/tracker.min.html

# Safety net : aucun fichier de credentials Google / Supabase / Wix
# ne doit JAMAIS atterrir dans ce repo. Les credentials Service
# Account GSC vivent dans ~/.claude/gsc-credentials.json (hors repo).
# Token OAuth GBP : ~/.claude/gbp-token.json (hors repo).
# Les secrets Supabase sont en env vars (cf scripts/gsc_ingest_*.py).
*credentials*.json
*-credentials.json
gbp-token.json
service-account*.json
*.pem
*.key
.vercel

# Artefacts de tests locaux (jsdom)
package.json
package-lock.json
node_modules/

# Sous-app dashboard (Next.js isolée) : son manifeste DOIT être suivi
# (les règles ci-dessus, pour le setup jsdom racine, le masqueraient sinon).
# node_modules/ et .env.local restent ignorés.
!dashboard/package.json
!dashboard/package-lock.json
