# Dashboard Cooked — variables d'environnement
# Copier en .env.local (gitignoré) et remplir. Sur Vercel : Settings → Environment Variables.

# URL du projet Supabase (publique).
NEXT_PUBLIC_SUPABASE_URL=https://mxycmjkeotrycyneacje.supabase.co

# Clé anon/publishable (publique, sûre côté navigateur — ne lit AUCUNE donnée métier : RLS deny-all).
# Sert uniquement au flux d'authentification (magic-link).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Clé service (SECRÈTE — serveur uniquement, jamais exposée au navigateur).
# Sert aux lectures de données via les RPC service_role.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Liste d'emails autorisés à se connecter (séparés par des virgules).
DASHBOARD_ALLOWED_EMAILS=nicolas@rewolf.studio
